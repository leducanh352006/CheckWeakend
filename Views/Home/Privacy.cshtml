@{
    ViewData["Title"] = "Chính sách Bảo mật";
}

<div class="container my-4">
    <div class="hero-glass-card">
        <h1 class="text-gradient fw-bold mb-4">
            <i class="fa-solid fa-shield-halved me-2"></i>Chính sách Bảo mật
        </h1>
        <p class="lead text-secondary">Ứng dụng CheckWeekend cam kết tôn trọng và bảo vệ quyền riêng tư của bạn.</p>

        <hr class="border-secondary my-4" />

        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-4 rounded bg-dark bg-opacity-40 border border-secondary border-opacity-25 h-100">
                    <h5 class="fw-bold text-info"><i class="fa-solid fa-database me-2"></i>Dữ liệu Cá nhân</h5>
                    <p class="text-secondary mb-0">Ứng dụng không thu thập hay lưu trữ bất kỳ thông tin cá nhân nào trên máy chủ. Mọi thao tác kiểm tra ngày tháng diễn ra hoàn toàn tức thì.</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-4 rounded bg-dark bg-opacity-40 border border-secondary border-opacity-25 h-100">
                    <h5 class="fw-bold text-success"><i class="fa-solid fa-lock me-2"></i>An toàn & Bảo mật</h5>
                    <p class="text-secondary mb-0">Ứng dụng được xây dựng trên nền tảng ASP.NET Core MVC (NET 10) hiện đại, tuân thủ các chuẩn bảo mật web tiêu chuẩn.</p>
                </div>
            </div>
        </div>
    </div>
</div>
