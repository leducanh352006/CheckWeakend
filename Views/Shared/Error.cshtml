@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="container mt-5">
    <div class="hero-glass-card text-center py-5">
        <h1 class="text-danger mb-3"><i class="fa-solid fa-triangle-exclamation"></i> Đã có lỗi xảy ra</h1>
        <p class="lead text-secondary">Hệ thống gặp sự cố khi xử lý yêu cầu của bạn.</p>

        @if (Model.ShowRequestId)
        {
            <div class="mt-4 p-3 rounded bg-dark border border-secondary text-mono d-inline-block">
                <small class="text-muted">Request ID:</small> <code>@Model.RequestId</code>
            </div>
        }

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-gradient">
                <i class="fa-solid fa-house me-2"></i>Quay lại Trang chủ
            </a>
        </div>
    </div>
</div>
