<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CheckWeekend App (.NET 10 MVC)</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Bootstrap & Custom CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark-app text-light">
    <header class="navbar-sticky">
        <nav class="navbar navbar-expand-lg glass-nav navbar-dark">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="fa-solid fa-calendar-check text-gradient"></i>
                    </div>
                    <span class="brand-text">Check<span class="text-accent">Weekend</span> <span class="badge bg-primary bg-opacity-25 text-info ms-1 style-badge">MVC .NET 10</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CheckWeekend" ? "active" : "")" asp-controller="Home" asp-action="CheckWeekend">
                                <i class="fa-solid fa-compass me-1"></i> Kiểm tra ngày
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Privacy" ? "active" : "")" asp-controller="Home" asp-action="Privacy">
                                <i class="fa-solid fa-shield-halved me-1"></i> Bảo mật
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-glass py-3 mt-auto border-top border-secondary border-opacity-25 text-center text-muted">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                &copy; @DateTime.Now.Year <strong>CheckWeekend App (ASP.NET Core MVC .NET 10)</strong>
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary me-3">Trang chủ</a>
                <a asp-controller="Home" asp-action="CheckWeekend" class="text-decoration-none text-secondary me-3">Kiểm tra ngày</a>
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-secondary">Bảo mật</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
